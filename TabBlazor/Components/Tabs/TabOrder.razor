@namespace TabBlazor
@inherits TablerBaseComponent

<li class="nav-item">
    <a @onclick="Activate" class="nav-link cursor-pointer @TitleCssClass @(IsEnabled ? "" : "disabled")"
       style="cursor: @(IsEnabled ? "pointer" : "not-allowed")" data-toggle="tab">
        @if (Header != null)
        {
            @Header
        }
        else
        {
            @Title
        }
    </a>
</li>
