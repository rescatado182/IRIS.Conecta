
<TablerForm Model="@personalData" >
    <DataGrid>


            <DataGridItem Title="Nombre completo">
                <input type="text" class="form-control" @bind="personalData.FullName"/>
                <ValidationMessage For="@(() => personalData.FullName)" class="text-danger" />           
            </DataGridItem>
        

            <DataGridItem Title="Documento Identidad">
                <input type="text" class="form-control" @bind="personalData.DocumentNumber"/>
                <ValidationMessage For="@(() => personalData.DocumentNumber)" class="text-danger" />   
            </DataGridItem>



            <DataGridItem Title="Tipo Documento">
                <Select Items="enumDocumentType"
                    @bind-SelectedValue="personalData.DocumentType"
                    TextExpression="e => Enum.GetName(typeof(EnumDocumentType), e)"
                    NoSelectedText="Seleccione un tipo de documento" />
                <ValidationMessage For="@(() => personalData.DocumentType)" class="text-danger" /> 
            </DataGridItem>


             <DataGridItem Title="País de nacimiento">
                <Typeahead TItem="CountryVM" TValue="CountryVM" SearchMethod="SearchCountries"
                           SelectedValue="personalData.BornCountry"
                           SelectedValueChanged="OnItemSelectedBorn"
               Debounce="1" MinimumLength="1" SearchPlaceholderText="Buscar País..."
               ListWidth="100%" SelectedTextExpression="e => e.Name" ShowOptionOnFocus="false" >
                    <ListTemplate Context="itemContext">
                        @itemContext.Name
                    </ListTemplate>
                </Typeahead>
                <ValidationMessage For="@(() => personalData.BornCountryId)" class="text-danger" />
            </DataGridItem> 

        <DataGridItem Title="Departamento de nacimiento">
                <Typeahead TItem="StateVM" TValue="StateVM" SearchMethod="SearchSates" SelectedValue="personalData.BornState" SelectedValueChanged="OnItemSelectedBorn"
                       Debounce="1" MinimumLength=1 SearchPlaceholderText="Buscar Departamento..."
                       ListWidth="100%" SelectedTextExpression="e => e.Name" ShowOptionOnFocus="false">
                    <ListTemplate Context="itemContext">
                        @itemContext.Name
                </ListTemplate>
            </Typeahead>
             <ValidationMessage For="@(() => personalData.BornStateId)" class="text-danger" />
        </DataGridItem>



        <DataGridItem Title="Ciudad de nacimiento">
                <Typeahead TItem="CityVM" TValue="CityVM" SearchMethod="SearchCities"
                       SelectedValue="personalData.BornCity"
                           SelectedValueChanged="OnItemSelectedBorn"
                       Debounce="1" 
                       MinimumLength="1" 
                       SearchPlaceholderText="Buscar ciudad..." 
                       ListWidth="100%" 
                       SelectedTextExpression="e => e.Name" 
                       ShowOptionOnFocus="false">
                    <ListTemplate Context="itemContext">
                        @itemContext.Name
                </ListTemplate>
            </Typeahead>
             <ValidationMessage For="@(() => personalData.BornCityId)" class="text-danger" />
        </DataGridItem>


     <DataGridItem Title="Departamento de Residencia">
                <Typeahead TItem="StateVM" TValue="StateVM" SearchMethod="SearchSatesResidence" SelectedValue="personalData.StateResidence" SelectedValueChanged="OnItemSelectedResidence"
                       Debounce="1" MinimumLength=1 SearchPlaceholderText="Buscar Departamento..."
                       ListWidth="100%"
                       SelectedTextExpression="e => e.Name" ShowOptionOnFocus="false">
                    <ListTemplate Context="itemContext">
                        @itemContext.Name
                </ListTemplate>
            </Typeahead>
             <ValidationMessage For="@(() => personalData.ResidenceStateId)" class="text-danger" />
        </DataGridItem>

        <DataGridItem Title="Ciudad de Residencia">
                <Typeahead TItem="CityVM" TValue="CityVM" SearchMethod="SearchCitiesResidence" SelectedValue="personalData.CityResidence" SelectedValueChanged="OnItemSelectedResidence"
                       Debounce="1" MinimumLength=1 SearchPlaceholderText="Buscar ciudad..."
                       ListWidth="100%"
                       SelectedTextExpression="e => e.Name" ShowOptionOnFocus="false">
                    <ListTemplate Context="itemContext">
                        @itemContext.Name
                </ListTemplate>
            </Typeahead>
             <ValidationMessage For="@(() => personalData.ResidenceCityId)" class="text-danger" />
        </DataGridItem>

        <DataGridItem Title="Dirección residencia">
            <input type="text" class="form-control" />
        </DataGridItem>

     <DataGridItem Title="Correo personal">
        <input type="text" class="form-control" />
      </DataGridItem>

      <DataGridItem Title="Correo del ITM">
        <input type="text" class="form-control" />
      </DataGridItem>

      <DataGridItem Title="Teléfono fijo">
       <input type="text" class="form-control" />
      </DataGridItem>
 
     <DataGridItem Title="Teléfono celular">
        <input type="text" class="form-control" />
     </DataGridItem>
                
</DataGrid>
</TablerForm>

<br />
<br />
