@page "/createticket/homologation"

@using TabBlazor.Services


<div class="page-header">Solicitud de Homologación</div>
<div class="page-subheader">
    Estás a punto de crear una solicitud de homologación. Para asegurarte de que tu solicitud sea procesada correctamente,
    completa todos los datos necesarios en el formulario. Esto nos ayudará a brindarte un mejor servicio y facilitar tu proceso.
</div>

<br />
@if (AlertMessages.Any())
{
    <Alert BackgroundColor="TablerColor.Warning" Title="Errores en el formulario" Dismissible Important>
        <div class="d-flex align-items-start">
            <div>
                <p class="fw-bold mb-2">Por favor, corrige los errores siguientes:</p>
                <br />
                <ul class="mb-0 ps-3">
                    @foreach (var message in AlertMessages)
                    {
                        <li class="text-white">@message</li>
                    }
                </ul>
            </div>
        </div>
    </Alert>
}

<TabBlazor.TabsOrder @ref="tabsOrderRef" KeepAlive="true">

    @* Datos Personales *@
    <TabBlazor.TabOrder>
        <Header>
            <StatusDot BackgroundColor="@((!isCompletedPersonalData ? TablerColor.Blue : TablerColor.Green))" />
            <Icon class="icon" IconType="@TablerIcons.User" Size="24" /> Datos Personales
        </Header>
        <ChildContent>
            <IRIS.UI.Pages.BL.Tickets.Shared.PersonalDataTicket @ref="personalDataRef" />
        </ChildContent>
    </TabBlazor.TabOrder>

    @* Datos Acádemicos *@
    <TabBlazor.TabOrder>
        <Header>
            <StatusDot BackgroundColor="@((!isCompletedAcademyData ? TablerColor.Blue : TablerColor.Green))" Animate />
            <Icon class="icon" IconType="@TablerIcons.Address_book" Size="24" /> Datos Académicos
        </Header>
        <ChildContent>

            <IRIS.UI.Pages.BL.Tickets.Shared.AcademyDataTicket @ref="academyDataRef" />

        </ChildContent>
    </TabBlazor.TabOrder>

    @* Justificación *@
    <TabBlazor.TabOrder>
        <Header>
            <StatusDot BackgroundColor="@((!isCompletedJustification ? TablerColor.Blue : TablerColor.Green))" Animate />
            <Icon class="icon" IconType="@TablerIcons.Ballpen" Size="24" /> Justificación
        </Header>
        <ChildContent>
            <JustificationMovilityTicket @ref="justificationMovilityRef">
            </JustificationMovilityTicket>

        </ChildContent>
    </TabBlazor.TabOrder>



</TabBlazor.TabsOrder>

<!-- Botón de navegación fuera de TabsOrder -->
<div class="d-flex justify-content-end mt-3">
    <!-- Botón Anterior -->
    <button class="btn btn-primary me-2" @onclick="PreviousStepAsync" disabled="@IsFirstTab">
        Anterior
    </button>

    <!-- Botón Siguiente -->
    @if (!IsLastTab)
    {
        <button class="btn btn-primary" @onclick="NextStepAsync">
            Siguiente
        </button>
    }

    <!-- Botón Guardar Solicitud -->
    @if (IsLastTab)
    {
        <button class="btn btn-success" @onclick="NextStepAsync">
            Guardar Solicitud
        </button>
    }
</div>




