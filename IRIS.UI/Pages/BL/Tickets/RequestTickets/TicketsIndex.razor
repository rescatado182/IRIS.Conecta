@page "/ticket/selection"

@if (faculties is null)
{
    <Loading></Loading>
}
else
{
    <div class="page-header">Inicia tu Nueva Solicitud</div>
    <div class="page-subheader">
        Configura tu solicitud paso a paso seleccionando las opciones necesarias. Una vez completada, podrás crear tu solicitud fácilmente.
    </div>

    <div class="form-section">
        <div class="form-instructions">
            <h5 class="instructions-header">¿Qué necesitas seleccionar?</h5>
            <ul class="instructions-list">
                <li><strong>Facultad:</strong> Selecciona la facultad correspondiente.</li>
                <li><strong>Departamento:</strong> Elige el departamento responsable de atender tu solicitud.</li>
                <li><strong>Tipo de Solicitud:</strong> Escoge el tipo de solicitud que deseas crear.</li>
            </ul>
        </div>

        <div class="form-fields">
            <div class="field-group">
                <label class="field-label">Facultad</label>
                <Typeahead SearchMethod="SearchFaculties" @bind-SelectedValue="selectedFaculty"
                           Debounce="1" MinimumLength=1 SearchPlaceholderText="Selecciona una Facultad"
                           ListWidth="100%" SelectedTextExpression="e => e.FacultyName" ShowOptionOnFocus="true">
                    <ListTemplate>
                        @context.FacultyName
                    </ListTemplate>
                </Typeahead>
            </div>

            @if (selectedFaculty != null)
            {
                <div class="field-group">
                    <label class="field-label">Departamento</label>
                    <Typeahead SearchMethod="SearchDepartments" @bind-SelectedValue="selectedDepartment"
                               Debounce="1" MinimumLength=1 SearchPlaceholderText="Selecciona un Departamento"
                               ListWidth="100%" SelectedTextExpression="e => e.DepartmentName" ShowOptionOnFocus="true">
                        <ListTemplate>
                            @context.DepartmentName
                        </ListTemplate>
                    </Typeahead>
                </div>
            }

            @if (selectedDepartment != null)
            {
                <div class="field-group">
                    <label class="field-label">Tipo de Solicitud</label>
                    <Typeahead SearchMethod="SearchRequestTypes" @bind-SelectedValue="selectedRequestType"
                               Debounce="1" MinimumLength=1 SearchPlaceholderText="Selecciona un Tipo de Solicitud"
                               ListWidth="100%" SelectedTextExpression="e => e.RequestName" ShowOptionOnFocus="true">
                        <ListTemplate>
                            @context.RequestName
                        </ListTemplate>
                    </Typeahead>
                </div>
            }
        </div>

        <div class="text-end mt-4">
            <TabBlazor.Button BackgroundColor="TablerColor.Primary" Type="ButtonType.Button" Text="Crear Solicitud" Disabled="@IsButtonDisabled" OnClick="HandleCreateRequest" />
        </div>
    </div>
}
