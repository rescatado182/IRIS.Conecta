
@page "/ticketDetailsSearch/{ticketId:int}"
@if (isLoading)
{
    <Loading></Loading>
}
else
{
    <div class="margin: 30px">

        <ButtonList>

            <Dropdown>
                <ChildContent>
                    <Button BackgroundColor="TablerColor.Primary" Type="ButtonType.Button" Text="Acciones de la Solicitud" IsDropdown />
                </ChildContent>

                <DropdownTemplate>
                    <DropdownMenu>

                        <DropdownItem OnClick="SendNotificationTicket">Enviar Notificación</DropdownItem>
                        <DropdownItem OnClick="ChangeStatusTicket">Cancelar Solicitud</DropdownItem>
                        <DropdownItem OnClick="TrackingTicket">Ver Tracking Solicitud</DropdownItem>

                    </DropdownMenu>
                </DropdownTemplate>

            </Dropdown>



        </ButtonList>
    </div>
    <br />

    <Card Size="CardSize.Default">
        <CardHeader>
            <h3>Información del Ticket</h3>
        </CardHeader>
        <CardBody>
            <DataGrid>

                <DataGridItem Title="Nro Solicitud">
                    <Badge BackgroundColor="TablerColor.Green">@ticket.Id</Badge>
                </DataGridItem>
                <DataGridItem Title="Fecha Solictud">
                    <span style="color: darkgray;">@ticket.DateCreated</span>
                </DataGridItem>
                <DataGridItem Title="Usuario">
                    <Badge BackgroundColor="TablerColor.Green">@ticket.UserName</Badge>
                </DataGridItem>
                <DataGridItem Title="Gestor">
                    <Badge BackgroundColor="TablerColor.Green">@ticket.ManagerUserName</Badge>
                </DataGridItem>
                <DataGridItem Title="Estado">
                    <Status BackgroundColor=@ticket.GetTicketStatusColor()>@statusText</Status>
                </DataGridItem>


            </DataGrid>
        </CardBody>
    </Card>
    <br />
    <Card Size="CardSize.Default">
        <CardHeader>
            <h3>Datos Personales</h3>
        </CardHeader>
        <CardBody>
            <DataGrid>

                <DataGridItem Title="Nombre completo">@personalDataTicket.FullName</DataGridItem>
                <DataGridItem Title="Documento Identidad">@personalDataTicket.DocumentNumber</DataGridItem>
                <DataGridItem Title="Tipo Documento">@personalDataTicket.DocumentType</DataGridItem>
                @* <DataGridItem Title="País de nacimiento">@personalDataTicket.BornCityId</DataGridItem>
            <DataGridItem Title="Departamento de nacimiento">@personalDataTicket.BornStateId</DataGridItem>
            <DataGridItem Title="Ciudad de nacimiento">@personalDataTicket.BornCityId</DataGridItem>
            <DataGridItem Title="Departamento de residencia">@personalDataTicket.ResidenceStateId</DataGridItem>
            <DataGridItem Title="Ciudad de residencia">@personalDataTicket.ResidenceCityId</DataGridItem> *@
                <DataGridItem Title="Dirección residencia">@personalDataTicket.AddressResidence</DataGridItem>
                <DataGridItem Title="Correo personal">@personalDataTicket.PersonalEmail</DataGridItem>
                <DataGridItem Title="Teléfono fijo">@personalDataTicket.Phone</DataGridItem>
                <DataGridItem Title="Teléfono celular">@personalDataTicket.Cellphone</DataGridItem>

            </DataGrid>
        </CardBody>
    </Card>
    <br />
    <Card Size="CardSize.Default">
        <CardHeader>
            <h3></h3>
        </CardHeader>
        <CardBody>
            <DataGrid>

                <DataGridItem Title="Title">
                    @ticket.Title
                </DataGridItem>

                <DataGridItem Title="Event Name">
                    @ticket.EventName
                </DataGridItem>
                <DataGridItem Title="Request Type">
                    <Badge BackgroundColor="TablerColor.Indigo">@ticket.RequestTypeId</Badge>
                </DataGridItem>

                <DataGridItem Title="Description">
                    <span style="color: darkgray;">@ticket.Description</span>
                </DataGridItem>

                <DataGridItem Title="Country">
                    <span>@ticket.Country</span>
                </DataGridItem>

                <DataGridItem Title="City">
                    <span>@ticket.City</span>
                </DataGridItem>

@*                 <DataGridItem Title="Phone">
                    <span>@ticket.Phone</span>
                </DataGridItem> *@

                <DataGridItem Title="Contact Data">
                    @ticket.ContactData
                </DataGridItem>

                <DataGridItem Title="External Institution">
                    @ticket.ExternalInstitution
                </DataGridItem>

                @*                 <DataGridItem Title="Start Date">
            <Badge BackgroundColor="TablerColor.Blue">@ticket.StartDate.ToString("yyyy-MM-dd")</Badge>
            </DataGridItem>

            <DataGridItem Title="End Date">
            <Badge BackgroundColor="TablerColor.Blue">@ticket.EndDate.ToString("yyyy-MM-dd")</Badge>
            </DataGridItem> *@

                <DataGridItem Title="Movility Type">
                    <Status BackgroundColor="TablerColor.Yellow">
                        @ticket.MovilityType
                    </Status>
                </DataGridItem>

                @*                 <DataGridItem Title="Requirements">
            <Badge BackgroundColor="TablerColor.Purple">@ticket.TicketRequirements</Badge>
            </DataGridItem> *@

                <DataGridItem Title="Total">
                    <span style="font-weight: bold;">@ticket.Total</span>
                </DataGridItem>

            </DataGrid>
        </CardBody>
    </Card>
    <br />
    <Card Size="CardSize.Default">
        <CardHeader>
            <h3>Información Personal</h3>
        </CardHeader>
        <CardBody>
            <DataGrid>
                <DataGridItem Title="Nombre">
                    Nombre Solicitante
                </DataGridItem>
            </DataGrid>
        </CardBody>
    </Card>
    <br />







}