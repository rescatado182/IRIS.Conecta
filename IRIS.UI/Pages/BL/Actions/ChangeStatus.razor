<div class="offcanvas-body">


    <div class="mb-3">
        <label>Estado Actual:</label>
        <p>@CurrentStatusText</p>
    </div>

    <div class="mb-3">
        <label>Nuevo Estado:</label>


        <Select Items="enumTicketStatus"
                @bind-SelectedValue="SelectedStatus"
                TextExpression="e => e.DisplayName"
                ValueExpression="e => e.Value"
                ConvertExpression="e => e.Value"
                NoSelectedText="Seleccione el nuevo estado" />

    </div>

    <Button BackgroundColor="TablerColor.Green" OnClick="OnSubmit">Guardar Cambios</Button>

    <br /> <br /> <br /> <br /> <br /> <br /> <br />
</div>
