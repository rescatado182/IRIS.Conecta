<div class="offcanvas-body">


    <div class="mb-3">
        <label>Estado Actual:</label>
        <p>@CurrentStatusDisplayName</p>
    </div>

    <div class="mb-3">
        <label>Nuevo Estado:</label>
        <ItemSelect TItem="TicketsStatus" TValue="TicketsStatus" Items="EnumHelper.GetList<TicketsStatus>()"
                    @bind-SelectedValue="SelectedStatus" TextExpression="e => e.ToString()" ValueExpression="e => e">
            <ListTemplate>
                @context
            </ListTemplate>
        </ItemSelect>
    </div>

    <Button BackgroundColor="TablerColor.Green" OnClick="OnSubmit">Guardar Cambios</Button>
    <br /> <br /> <br /> <br /> <br /> <br /> <br />
</div>
