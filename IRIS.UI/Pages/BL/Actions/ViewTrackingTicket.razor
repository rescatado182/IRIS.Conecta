<Timeline Type="TimelineType.Default">
    @if (Notifications != null && Notifications.Any())
    {
        @foreach (var notification in Notifications)
        {
            <TimelineItem Time="@notification.DateCreated.ToString("yyyy-MM-dd")"
                          Title="@GetTitle(notification.NotificationTypeEnum)"
                          IconColor="@GetIconColor(notification.NotificationTypeEnum)"
                          IconText="@notification.NotificationTypeEnum.ToString()">
                <IconTemplate>
                    <Icon IconType="@GetIcon(notification.NotificationTypeEnum)" Size="16" />
                </IconTemplate>
                <ChildContent>
                    <p class="text-secondary">@notification.Message</p>
                </ChildContent>
            </TimelineItem>
        }
    }
    else
    {
        <p>No hay notificaciones disponibles.</p>
    }
</Timeline>
