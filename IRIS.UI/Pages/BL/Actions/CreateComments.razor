<div>
    <h3>Agregar Comentario</h3>
    <div>
        <textarea class="form-control" @bind="CommentText" placeholder="Escribe tu comentario aquí"></textarea>
    </div>
    <div class="form-check mt-3">
        <input class="form-check-input" type="checkbox" @bind="SendByEmail" id="sendEmailCheckbox" />
        <label class="form-check-label" for="sendEmailCheckbox">Enviar por correo</label>
    </div>
    <button class="btn btn-primary mt-3" @onclick="HandleSubmit">Enviar Comentario</button>
</div>