@if (resultados != null && resultados.Any())
{
    <Timeline Type="TimelineType.Simple">
        @foreach (var item in resultados)
        {
            <TimelineItem Time="@item.id" IconColor="TablerColor.Red" Title="Id">
                <IconTemplate>
                    <Icon IconType="@TablerIcons.Brand_twitter" Size="16" />
                </IconTemplate>
                <ChildContent>
                    <p class="card-text"><strong>Solicitud:</strong> @item.Request</p>
                    <p class="card-text"><strong>Respuesta:</strong> @item.Answer</p>
                    <p class="card-text"><strong>Score:</strong> @item.score</p>
                </ChildContent>
            </TimelineItem>
        }
    </Timeline>
}
else
{
    <p>No hay resultados para mostrar.</p>
}

