@page "/similaranswer"



@if (resultados != null && resultados.Any())
{
    <Card>
        <CardBody>
            <div class="header-container">
                <h3 class="main-title">🔍 Encuentra Respuestas Relevantes para tu Solicitud</h3>
                <h4 class="sub-title">💡 Nuestra inteligencia artificial ha identificado solicitudes similares previamente resueltas. Úsalas como inspiración para responder más rápido y con mayor precisión.</h4>
            </div>
        </CardBody>
@*         <CardFooter>
            <button class="btn btn-primary btn-sm">Aprender más sobre recomendaciones</button>
    </CardFooter>*@
    </Card> 


    <br />
    <Timeline Type="TimelineType.Simple">
        @foreach (var item in resultados)
        {
            <TimelineItem Time="" IconColor="TablerColor.Red" Title="@item.Programa">
                <IconTemplate>
                    <Icon IconType="@TablerIcons.Brand_twitter" Size="16" />
                </IconTemplate>
                <ChildContent>
                    
                        <p class="card-text">
                        <Badge BackgroundColor="TablerColor.Green" Size=BadgeSize.Large BadgeType="BadgeType.Light">@item.tipo_movilidad</Badge>
                        </p>
                    

                    <p class="card-text"><strong>
                        <Badge BackgroundColor="TablerColor.Primary" BadgeType="BadgeType.Outline">Solicitud Realizada:</Badge></strong> @item.Solicitud</p>
                    <p class="card-text"><strong><Badge BackgroundColor="TablerColor.Primary" BadgeType="BadgeType.Outline">Respuesta de la Facutad:</Badge></strong> @item.Respuesta</p>

                    <div class="text-end">
                        <a href="@GenerateLink(item.Id)" target="_blank" class="btn btn-primary sm">
                            Nro Solicitud: @item.Id
                        </a>
                    </div>

                </ChildContent>
            </TimelineItem>
        }
    </Timeline>
}
else
{
    <Loading></Loading>
    if (resultados.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            Buscando resultados...
        </div>
    }
    else
    {
    <Loading></Loading>
    }
}

