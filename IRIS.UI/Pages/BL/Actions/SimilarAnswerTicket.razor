@page "/similaranswer"

<h3>Estas son solicitudes que fueron respondidas anteriormente y que te pueden ayudar a atender esta solicitud más rápido!</h3>
<h4> Recuerda, solo son sugerencias...</h4>



@* Formulario para capturar los datos *@
<div>
    <label>Consulta:</label>
    <input @bind="rootRequest.Body.Query" placeholder="Escribe tu consulta" />

    <label>Tipo de Solicitud:</label>
    <input @bind="rootRequest.Body.Filtros.Tipo_solicitud" placeholder="Tipo de solicitud" />

    <label>Top K:</label>
    <input @bind="rootRequest.Body.Top_k" type="number" />

    <button @onclick="SendData">Enviar</button>
</div>

