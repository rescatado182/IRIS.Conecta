<div>
    <h3>Agregar Comentario</h3>

    <!-- Texto del comentario -->
    <div class="mb-3">

        <textarea type="text" class="form-control" @bind="CommentText" Rows="5" Style="width: 100%;"></textarea>
    </div>

    <!-- Checkbox para enviar por correo -->
    <div class="form-check mb-3">
        <Checkbox TValue="bool" @bind-Value="SendByEmail">Enviar por correo</Checkbox>
    </div>

    <!-- Botón para enviar -->
    <div class="mb-3">
        <Button BackgroundColor="TablerColor.Blue" OnClick="OnSubmitAsync" Disabled="IsSubmitting">Enviar Comentario</Button>
    </div>
</div>