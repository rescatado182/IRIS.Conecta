@page "/ticketDetails/{ticketId:int}"
@if (ticket is null)
{
    <Loading></Loading>
}
else{
    <div class="margin: 30px">


    <ButtonList>
            <Button BackgroundColor="TablerColor.Secondary" Type="ButtonType.Link" LinkTo="managesTickets">Bandeja de Gestión</Button>

        <Dropdown>
            <ChildContent>
                <Button BackgroundColor="TablerColor.Primary" Type="ButtonType.Button" Text="Acciones de la Solicitud" IsDropdown />
            </ChildContent>

            <DropdownTemplate>
                <DropdownMenu>
                    <DropdownItem OnClick="ChangeStatusTicket">Cambiar Estado</DropdownItem>
                    <DropdownItem OnClick="SendNotificationTicket">Enviar Notificación</DropdownItem>
                    <DropdownItem OnClick="TrackingTicket">Ver Tracking Solicitud</DropdownItem>
                    <DropdownItem OnClick="EscalateTicket">Escalar</DropdownItem>
                    <DropdownItem OnClick="ResponseTicket">Responder</DropdownItem>
                    <DropdownItem OnClick="SimilarAnswer">Ver Recomendaciones de Respuesta</DropdownItem>
                </DropdownMenu>
            </DropdownTemplate>

        </Dropdown>


            <Dropdown>
                <ChildContent>
                    <Button BackgroundColor="TablerColor.Yellow" Type="ButtonType.Button" Text="Acciones de la Solicitud" IsDropdown />
                </ChildContent>

                <DropdownTemplate>
                    <DropdownMenu>

                        <DropdownItem OnClick="SendNotificationTicket">Enviar Notificación</DropdownItem>
                        <DropdownItem OnClick="ChangeStatusTicket">Cancelar Solicitud</DropdownItem>
                        <DropdownItem OnClick="TrackingTicket">Ver Tracking Solicitud</DropdownItem>

                    </DropdownMenu>
                </DropdownTemplate>

            </Dropdown>

        </ButtonList>


    </div>
    <br />

        <Card Size="CardSize.Default">
            <CardHeader>
                <h3>Información del Ticket</h3>
            </CardHeader>
            <CardBody>
                <DataGrid>

                    <DataGridItem Title="Nro Solicitud">
                        <Badge BackgroundColor="TablerColor.Green">@ticket.Id</Badge>
                    </DataGridItem>
                    <DataGridItem Title="Fecha Solictud">
                        <span style="color: darkgray;">@ticket.dateCreated</span>
                    </DataGridItem>
                    <DataGridItem Title="Usuario">
                    <Badge BackgroundColor="TablerColor.Green">@ticket.UserName</Badge>
                    </DataGridItem>
                    <DataGridItem Title="Gestor">
                        <Badge BackgroundColor="TablerColor.Green">@ticket.ManagerUserName</Badge>
                    </DataGridItem>
                    <DataGridItem Title="Estado">
                    <Status BackgroundColor=@ticket.GetTicketStatusColor()>@statusText</Status>
                    </DataGridItem>


                </DataGrid>
            </CardBody>
        </Card>
        <br />
        <Card Size="CardSize.Default">
            <CardHeader>
                <h3>Datos Personales</h3>
            </CardHeader>
            <CardBody>
                    <DataGrid>

                <DataGridItem Title="Nombre completo">@personalDataTicket.FullName</DataGridItem>
                <DataGridItem Title="Documento Identidad">@personalDataTicket.DocumentNumber</DataGridItem>
                <DataGridItem Title="Tipo Documento">@personalDataTicket.DocumentType</DataGridItem>
                <DataGridItem Title="País de nacimiento">@personalDataTicket.BornCityId</DataGridItem>
                <DataGridItem Title="Departamento de nacimiento">@personalDataTicket.BornStateId</DataGridItem>
                <DataGridItem Title="Ciudad de nacimiento">@personalDataTicket.BornCityId</DataGridItem>
                <DataGridItem Title="Departamento de residencia">@personalDataTicket.ResidenceStateId</DataGridItem>
                <DataGridItem Title="Ciudad de residencia">@personalDataTicket.ResidenceCityId</DataGridItem>
                <DataGridItem Title="Dirección residencia">@personalDataTicket.AddressResidence</DataGridItem>
                <DataGridItem Title="Correo personal">@personalDataTicket.PersonalEmail</DataGridItem>
                <DataGridItem Title="Teléfono fijo">@personalDataTicket.Phone</DataGridItem>
                <DataGridItem Title="Teléfono celular">@personalDataTicket.Cellphone</DataGridItem>


                    </DataGrid>
            </CardBody>
        </Card>
        <br />
        <Card Size="CardSize.Default">
                    <CardHeader>
                <h3>Datos Acádemicos</h3>
            </CardHeader>
            <CardBody>
                    <DataGrid>


                <DataGridItem Title="Programa">@academicDataTicket.ProgramId</DataGridItem>
                <DataGridItem Title="Proyecto de investigación (S/A)">@academicDataTicket.ResearchProject</DataGridItem>
                <DataGridItem Title="Promedio crédito">@academicDataTicket.AverageCredit</DataGridItem>
                 <DataGridItem Title="Tipo de formación">@academicDataTicket.ProgramType.ToString()</DataGridItem> 
                <DataGridItem Title="G. de investigación/Semillero (S/A)">@academicDataTicket.ResearchGroup</DataGridItem>
                <DataGridItem Title="¿Pertenece a algún grupo cultural o deportivo institucional?">@(academicDataTicket.IsInstitutionalGroup ? "Sí" : "No")</DataGridItem>


                    </DataGrid>
            </CardBody>
        </Card>
        <br />

    <Card Size="CardSize.Default">
        <CardHeader>
            <h3>Tipo de Movilidad</h3>
        </CardHeader>
        <CardBody>
            <DataGrid>

                <DataGridItem Title="Tipo de Movilidad">
                    <Badge BackgroundColor="TablerColor.Green" Size=BadgeSize.Large BadgeType="BadgeType.Light">@ticket.MovilityTypeDisplayName</Badge>
                </DataGridItem>
                <DataGridItem Title="Institución de destino">@ticket.ExternalInstitution</DataGridItem>
                <DataGridItem Title="Datos de contacto">@ticket.ContactData</DataGridItem>
                <DataGridItem Title="País de destino">@ticket.Country</DataGridItem>
                <DataGridItem Title="Ciudad de Destino">@ticket.City</DataGridItem>
                <DataGridItem Title="Nombre de la actividad que origina la movilidad">@ticket.EventName</DataGridItem>
                <DataGridItem Title="Título de la ponencia (S/A)">@ticket.Title</DataGridItem>
                <DataGridItem Title="Fecha de inicio movilidad">@ticket.StartDateMovility</DataGridItem>
                <DataGridItem Title="Fecha final movilidad">@ticket.EndDateMovility</DataGridItem>

            </DataGrid>
        </CardBody>
    </Card>
    <br />

    <Card Size="CardSize.Default">
        <CardHeader>
            <h3>Justificación</h3>
        </CardHeader>
        <CardBody>
            <DataGrid>

                <DataGridItem Title="La movilidad está dada en el marco de un convenio">@(ticket.IsAgreement ? "Sí" : "No")</DataGridItem>
                <DataGridItem Title="Convenio (S/A)">
                    <Badge BackgroundColor="TablerColor.Green" BadgeType="BadgeType.Outline">@ticket.AgreementName</Badge>
                </DataGridItem>
                <DataGridItem Title="Objetivo de la movilidad">
                    <Badge BackgroundColor="TablerColor.Orange" BadgeType="BadgeType.Outline">@ticket.Description</Badge>
                </DataGridItem>
                <DataGridItem Title="Productos a entregar en retribución">@ticket.Results</DataGridItem>
                <DataGridItem Title="Fecha entrega compromisos">@ticket.DeliveryDate</DataGridItem>


            </DataGrid>
        </CardBody>
    </Card>
    <br />











}