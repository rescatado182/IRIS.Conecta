@page "/departments"


@if (departments is null)
{
    <Loading></Loading>
}
else
{


    <Table Item="DepartmentsVM" Items="departments" PageSize="10" AddItemFactory="AddItem" OnItemEdited="OnItemEdit"
            OnBeforeEdit="BeforeEdit" OnItemAdded="OnItemAdd" OnItemDeleted="OnItemDelete"
            ShowCheckboxes MultiSelect Hover Responsive EditMode=TableEditMode.Popup EditPopupMutator=EditPopupOptions>
       
        <HeaderTemplate>
            <strong>Departamentos</strong>
        </HeaderTemplate>

        <ChildContent>

            <Column Item="DepartmentsVM" Property="e=>e.DepartmentName" Title="Nombre" Sortable Searchable Groupable>
                <EditorTemplate>
                    <input type="text" class="form-control" @bind-value="@context.DepartmentName" />
                </EditorTemplate>
            </Column>

            <Column Item="DepartmentsVM" Property="e=>e.Faculty.FacultyName" Title="Facultad" Sortable Searchable Groupable>
                <EditorTemplate>
                    <Select Items="faculties" @bind-SelectedValue="selectedFaculty" TextExpression="e=> e.FacultyName.ToString()" ValueExpression="e=> e.Id" Clearable />
                </EditorTemplate>
            </Column>

@* 
            @if (selectedFaculty != null)
            {
                <div>@selectedFaculty.FacultyName [@selectedFaculty.Id]</div>
            }
 *@


        </ChildContent>
    </Table>


}