@page "/programs"


@if (programs is null)
{
    <Loading></Loading>
}
else
{


    <Table Item="ProgramVM" Items="programs" PageSize="10" OnItemEdited="OnItemEdit"
           OnBeforeEdit="BeforeEdit" OnItemAdded="OnItemAdd" OnItemDeleted="OnItemDelete"
           ShowCheckboxes MultiSelect Hover Responsive EditMode=TableEditMode.Popup EditPopupMutator=EditPopupOptions>
        <HeaderTemplate>
            <strong>Departamentos</strong>
        </HeaderTemplate>

        <ChildContent>

            <Column Item="ProgramVM" Property="e=>e.ProgramName" Title="Nombre" Sortable Searchable Groupable>
                <EditorTemplate>
                    <input type="text" class="form-control" @bind-value="@context.ProgramName" />
                </EditorTemplate>
            </Column>





            <Column Item="ProgramVM" Property="e=>e.ProgramType" Title="Tipo de formación">
                 <EditorTemplate>
                <Select Items="enumProgramType"
                        @bind-SelectedValue="selectedProgramType"
                        TextExpression="e => Enum.GetName(typeof(EnumProgramType), e)"
                        NoSelectedText="" />
                </EditorTemplate>
            </Column>

            <Column Item="ProgramVM" Property="e=>e.DepartmentName" Title="Departamento" Sortable Searchable Groupable>
                <EditorTemplate>
                    <Select Items="departments" @bind-SelectedValue="selectedDepartment" TextExpression="e=> e.DepartmentName.ToString()" ValueExpression="e=> e.Id" Clearable />
                </EditorTemplate>
            </Column>

@*             <div class="mt-3 hidden">
                @if (selectedDepartment != null)
                {
                    <div>@selectedDepartment.DepartmentName [@selectedDepartment.Id]</div>
                }
            </div> *@


        </ChildContent>
    </Table>


}
