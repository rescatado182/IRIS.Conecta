@page "/faculties"

@if (faculties is null)
{
    <Loading></Loading>
}
else{


<Table Item="FacultyVM" Items="faculties" PageSize="10" AddItemFactory="AddItem" OnItemEdited="OnItemEdit"
           OnBeforeEdit="BeforeEdit" OnItemAdded="OnItemAdd" OnItemDeleted="OnItemDelete"
           ShowCheckboxes MultiSelect Hover Responsive EditMode=TableEditMode.Popup EditPopupMutator=EditPopupOptions>
    <HeaderTemplate>
        <strong>Facultades</strong>
    </HeaderTemplate>

    <ChildContent>
            <Column Item="FacultyVM" Property="e=>e.FacultyName" Title="Nombre" Sortable Searchable Groupable >
            <EditorTemplate>

                <input type="text" class="form-control" @bind-value="@context.FacultyName" />   
                    <ValidationMessage For="@(() => @context.FacultyName)" class="text-danger" />
            </EditorTemplate>
           
        </Column>

    </ChildContent>
    
</Table>


}

