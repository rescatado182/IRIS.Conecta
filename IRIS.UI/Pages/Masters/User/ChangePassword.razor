@page "/change-password"
@using System.ComponentModel.DataAnnotations




<Card Size="CardSize.Medium" class="w-50 mx-auto">
    <CardHeader>
        <h3>Cambiar Contraseña</h3>
    </CardHeader>
    <CardBody>
        <TablerForm Model="passwordModel">
            <DataGrid>
                <DataGridItem Title="Contraseña Actual">
                    <input type="password" class="form-control" @bind="passwordModel.CurrentPassword" />
                    <ValidationMessage For="@(() => passwordModel.CurrentPassword)" class="text-danger" />
                </DataGridItem>
                <DataGridItem Title="Nueva Contraseña">
                    <input type="password" class="form-control" @bind="passwordModel.NewPassword" />
                    <ValidationMessage For="@(() => passwordModel.NewPassword)" class="text-danger" />
                </DataGridItem>
                <DataGridItem Title="Confirmar Nueva Contraseña">
                    <input type="password" class="form-control" @bind="passwordModel.ConfirmPassword" />
                    <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" class="text-danger" />
                </DataGridItem>

            </DataGrid>
        </TablerForm>

        <div class="text-end mt-4">
            <TabBlazor.Button BackgroundColor="TablerColor.Primary" Type="ButtonType.Button" Text="Cambiar Contraseña" OnClick="HandlePasswordChangeAsync" Icon="fa fa-sign-in" Class="px-4" />
        </div>
    </CardBody>
</Card>
