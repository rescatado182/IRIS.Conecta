@page "/forgot-password"
@layout LoginLayout

@using TabBlazor.Components.Modals
@using Microsoft.AspNetCore.Components
@using System.ComponentModel.DataAnnotations

<div style="background: linear-gradient(135deg, #b2babb, #b2babb); min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <Card Size="CardSize.Medium" BackgroundColor="TablerColor.White" Class="shadow-lg" Style="border-radius: 12px; max-width: 500px; padding: 20px;">
        <CardBody>
            <!-- Logo y título -->
            <div class="text-center">
                <img src="img/Logoiris.png" alt="Logo IRIS Conecta" style="width: 150px; margin-bottom: 20px;" />
                <h2>Recupera tu contraseña</h2>
                <p>Ingresa tu correo electrónico y te enviaremos un enlace para recuperar tu contraseña.</p>
            </div>

            <!-- Formulario de recuperación de contraseña -->
            <TablerForm Model="@forgotPasswordModel">
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <InputText class="form-control" @bind-Value="forgotPasswordModel.Email" placeholder="Ingresa tu correo" />
                    <TabValidationMessage For="(() => forgotPasswordModel.Email)"></TabValidationMessage>
                </div>

                <div class="text-end mt-4">
                    <TabBlazor.Button BackgroundColor="TablerColor.Primary" Type="ButtonType.Button" OnClick="SendLinkForgotAsync" Text="Enviar enlace" Icon="fa fa-envelope" Class="px-4" />
                </div>
            </TablerForm>

            <!-- Enlace para volver al login -->
            <div class="text-center mt-3">
                <a href="/login" style="font-size: 0.9rem; color: #007bff; text-decoration: none;">
                    Volver a Iniciar Sesión
                </a>
            </div>
        </CardBody>
    </Card>
</div>


